<?xml version="1.0" encoding="utf-8"?>
<!--
  Конфигурация службы из D-014.

  canRequestFilterKeyEvents + flagRequestFilterKeyEvents — обязательная пара: без них
  onKeyEvent не вызывается. Флаг дополнительно применяется в onServiceConnected(),
  а приложение показывает то, что реально приняла система.

  isAccessibilityTool="false" — честно: это утилита переназначения кнопок мыши,
  а не средство для людей с инвалидностью. HyperOS 3 включает такую службу без
  «ограниченных настроек» (проверено в S2).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="50"
    android:settingsActivity="com.mousemanager.MainActivity" />
